<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zukadino Marketing | نحو علامتك التجارية، نحقق نتائج حقيقية</title>
<meta name="description" content="زوكادينو للتسويق الرقمي والإعلانات — إدارة سوشيال ميديا، إعلانات ممولة، تصميم هوية بصرية، وموشن جرافيك بالذكاء الاصطناعي. نتائج مضمونة، مش مجرد إعلان.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700;800&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --orange:#EA5B14;
    --orange-2:#F97A2E;
    --orange-dark:#B84610;
    --ink:#141311;
    --ink-2:#2A2724;
    --paper:#FBF8F4;
    --paper-2:#F3EEE6;
    --line:#E4DDD1;
    --cream-card:#FFFFFF;
    --muted:#6B6459;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans Arabic', sans-serif;
    line-height:1.7;
    overflow-x:hidden;
  }
  .disp{font-family:'Almarai', sans-serif;}
  .num{font-family:'Space Grotesk', sans-serif;}
  img{max-width:100%; display:block;}
  a{color:inherit; text-decoration:none;}
  .wrap{max-width:1200px; margin:0 auto; padding:0 28px;}
  ::selection{background:var(--orange); color:#fff;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
  }

  a:focus-visible, button:focus-visible{
    outline:3px solid var(--orange-dark);
    outline-offset:3px;
    border-radius:4px;
  }

  /* page load fade */
  body{animation:pagein .7s ease both;}
  @keyframes pagein{from{opacity:0;} to{opacity:1;}}

  /* ---------- NAV ---------- */
  header{
    position:sticky; top:0; z-index:80;
    background:rgba(251,248,244,0.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav.wrap{
    display:flex; align-items:center; justify-content:space-between;
    padding-top:14px; padding-bottom:14px;
  }
  .brand{display:flex; align-items:center; gap:12px;}
  .brand img{height:44px; width:auto;}
  .brand-name{font-family:'Almarai',sans-serif; font-weight:800; font-size:1.15rem; letter-spacing:.5px;}
  .brand-name span{color:var(--orange);}
  .nav-links{display:flex; gap:34px; font-weight:600; font-size:.98rem;}
  .nav-links a{position:relative; padding:4px 0; color:var(--ink-2);}
  .nav-links a::after{
    content:''; position:absolute; right:0; bottom:-3px; width:0; height:2px; background:var(--orange);
    transition:width .25s ease;
  }
  .nav-links a:hover::after{width:100%;}
  .nav-cta{
    background:var(--ink); color:#fff !important; padding:11px 22px; border-radius:999px;
    font-weight:700; font-size:.92rem; display:flex; align-items:center; gap:8px;
    transition:background .25s ease, transform .2s ease;
  }
  .nav-cta:hover{background:var(--orange); transform:translateY(-2px);}
  .nav-right{display:flex; align-items:center; gap:14px;}

  .burger{
    display:none; flex-direction:column; gap:5px; width:40px; height:40px;
    align-items:center; justify-content:center; border:1px solid var(--line); border-radius:10px;
    background:#fff; cursor:pointer;
  }
  .burger span{width:18px; height:2px; background:var(--ink); transition:transform .25s ease, opacity .25s ease;}
  .burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .burger.open span:nth-child(2){opacity:0;}
  .burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

  .mobile-menu{
    position:fixed; inset:0; background:var(--ink); z-index:90;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:30px;
    transform:translateY(-100%); transition:transform .4s cubic-bezier(.4,0,.2,1);
  }
  .mobile-menu.open{transform:translateY(0);}
  .mobile-menu a{color:#fff; font-family:'Almarai',sans-serif; font-weight:700; font-size:1.5rem;}
  .mobile-menu .close-btn{position:absolute; top:22px; left:24px; color:#fff; font-size:1.8rem; background:none; border:none; cursor:pointer;}
  .mobile-menu .m-cta{background:var(--orange); color:#fff; padding:14px 30px; border-radius:999px; font-size:1.05rem;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    padding:96px 0 0;
    overflow:hidden;
  }
  #hero-canvas{
    position:absolute; inset:0; width:100%; height:100%; z-index:0; opacity:.55;
    pointer-events:none;
  }
  .hero-grid{
    position:relative; z-index:1;
    display:grid; grid-template-columns:1.1fr .9fr; gap:40px; align-items:center;
    padding-bottom:60px;
  }
  .eyebrow{
    display:inline-flex; align-items:center; gap:10px;
    background:#fff; border:1px solid var(--line); padding:8px 16px; border-radius:999px;
    font-weight:700; font-size:.85rem; color:var(--orange-dark); margin-bottom:26px;
  }
  .eyebrow .dot{width:7px; height:7px; border-radius:50%; background:var(--orange); box-shadow:0 0 0 4px rgba(234,91,20,.18); animation:pulse 1.8s ease infinite;}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 4px rgba(234,91,20,.18);} 50%{box-shadow:0 0 0 8px rgba(234,91,20,.08);}}
  h1.hero-title{
    font-family:'Almarai',sans-serif; font-weight:800;
    font-size:clamp(2.3rem, 4.6vw, 3.8rem);
    line-height:1.22;
    margin-bottom:22px;
  }
  h1.hero-title .accent{
    color:var(--orange);
    position:relative;
    white-space:nowrap;
  }
  .hero-sub{
    font-size:1.14rem; color:var(--muted); max-width:520px; margin-bottom:34px;
  }
  .hero-actions{display:flex; gap:16px; flex-wrap:wrap; margin-bottom:44px;}
  .btn{
    display:inline-flex; align-items:center; gap:10px;
    padding:16px 30px; border-radius:12px; font-weight:700; font-size:1rem;
    transition:transform .22s ease, box-shadow .22s ease, background .22s ease;
    cursor:pointer; border:none; position:relative;
  }
  .btn-primary{
    background:var(--orange); color:#fff;
    box-shadow:0 10px 24px -8px rgba(234,91,20,.55);
  }
  .btn-primary:hover{transform:translateY(-3px); box-shadow:0 16px 30px -8px rgba(234,91,20,.65); background:var(--orange-2);}
  .btn-ghost{
    background:transparent; color:var(--ink); border:1.5px solid var(--ink);
  }
  .btn-ghost:hover{background:var(--ink); color:#fff; transform:translateY(-3px);}

  .hero-stats{display:flex; gap:34px; flex-wrap:wrap;}
  .hero-stats .stat b{
    font-family:'Space Grotesk',sans-serif; font-size:1.7rem; font-weight:700; display:block; color:var(--ink);
  }
  .hero-stats .stat span{font-size:.86rem; color:var(--muted);}

  /* signature: growth arrow chart */
  .chart-card{
    position:relative;
    background:var(--ink);
    border-radius:24px;
    padding:34px 30px 26px;
    box-shadow:0 30px 60px -20px rgba(20,19,17,.45);
  }
  .chart-card .tag{
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(255,255,255,.08); color:#fff; font-size:.78rem; font-weight:600;
    padding:6px 12px; border-radius:999px; margin-bottom:18px;
  }
  .chart-card .tag .dot{width:6px; height:6px; border-radius:50%; background:#59D98C;}
  .chart-card svg{width:100%; height:auto; display:block;}
  .chart-caption{display:flex; justify-content:space-between; margin-top:18px; color:#B9B4AC; font-size:.82rem;}
  .chart-caption b{color:#fff; font-family:'Space Grotesk',sans-serif; font-size:1.15rem; display:block;}

  .growth-path{
    stroke-dasharray:900;
    stroke-dashoffset:900;
    animation:draw 2.1s cubic-bezier(.4,0,.2,1) .3s forwards;
  }
  .growth-fill{opacity:0; animation:fadein 1s ease 1.6s forwards;}
  .growth-dot{opacity:0; animation:fadein .4s ease forwards;}
  .growth-dot:nth-of-type(1){animation-delay:.6s;}
  .growth-dot:nth-of-type(2){animation-delay:1.05s;}
  .growth-dot:nth-of-type(3){animation-delay:1.5s;}
  .growth-dot:nth-of-type(4){animation-delay:1.95s;}
  @keyframes draw{to{stroke-dashoffset:0;}}
  @keyframes fadein{to{opacity:1;}}

  /* marquee ticker */
  .marquee{
    position:relative; z-index:1;
    background:var(--ink); color:#fff; overflow:hidden;
    padding:16px 0; white-space:nowrap;
  }
  .marquee-track{
    display:inline-flex; gap:40px; animation:scroll-left 26s linear infinite;
  }
  .marquee:hover .marquee-track{animation-play-state:paused;}
  .marquee-track span{
    font-family:'Almarai',sans-serif; font-weight:700; font-size:1.05rem;
    display:inline-flex; align-items:center; gap:16px; color:#EDE8DF;
  }
  .marquee-track span::after{content:'✦'; color:var(--orange-2); font-size:.9rem;}
  @keyframes scroll-left{from{transform:translateX(0);} to{transform:translateX(-50%);}}

  /* ---------- SECTION HEADERS ---------- */
  .section{padding:96px 0;}
  .section-alt{background:var(--paper-2);}
  .sec-head{max-width:640px; margin-bottom:56px;}
  .sec-eyebrow{
    color:var(--orange-dark); font-weight:700; font-size:.85rem; letter-spacing:.5px;
    display:flex; align-items:center; gap:10px; margin-bottom:14px;
  }
  .sec-eyebrow::before{content:''; width:26px; height:2px; background:var(--orange);}
  .sec-title{font-family:'Almarai',sans-serif; font-weight:800; font-size:clamp(1.7rem,3vw,2.5rem); line-height:1.3;}
  .sec-title span{color:var(--orange);}
  .sec-sub{color:var(--muted); margin-top:14px; font-size:1.04rem;}

  /* ---------- SERVICES ---------- */
  .services-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:22px;
  }
  .svc-card{
    background:var(--cream-card); border:1px solid var(--line); border-radius:20px;
    padding:30px 26px; transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .svc-card:hover{
    transform:translateY(-6px);
    box-shadow:0 22px 40px -18px rgba(20,19,17,.22);
    border-color:transparent;
  }
  .svc-icon{
    width:52px; height:52px; border-radius:14px; background:var(--paper-2);
    display:flex; align-items:center; justify-content:center; margin-bottom:20px;
    color:var(--orange); transition:background .25s ease, color .25s ease, transform .35s ease;
  }
  .svc-card:hover .svc-icon{background:var(--orange); color:#fff; transform:rotate(-6deg) scale(1.08);}
  .svc-card h3{font-family:'Almarai',sans-serif; font-weight:700; font-size:1.14rem; margin-bottom:10px;}
  .svc-card p{color:var(--muted); font-size:.95rem;}

  /* ---------- PORTFOLIO ---------- */
  .work-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
  }
  .work-card{
    position:relative; border-radius:18px; overflow:hidden; cursor:pointer;
    aspect-ratio:4/5; background:var(--ink);
    box-shadow:0 12px 26px -14px rgba(20,19,17,.3);
  }
  .work-card img{
    width:100%; height:100%; object-fit:cover; object-position:top;
    transition:transform .5s cubic-bezier(.2,.7,.3,1), filter .4s ease;
  }
  .work-card:hover img{transform:scale(1.08); filter:brightness(.75);}
  .work-overlay{
    position:absolute; inset:0; display:flex; align-items:flex-end; padding:20px;
    background:linear-gradient(180deg, transparent 40%, rgba(10,9,8,.85) 100%);
    opacity:0; transition:opacity .35s ease;
  }
  .work-card:hover .work-overlay{opacity:1;}
  .work-overlay span{
    color:#fff; font-family:'Almarai',sans-serif; font-weight:700; font-size:1rem;
    display:flex; align-items:center; gap:8px;
  }
  .work-overlay svg{width:18px; height:18px; color:var(--orange-2);}

  /* lightbox */
  .lightbox{
    position:fixed; inset:0; background:rgba(10,9,8,.92); z-index:120;
    display:flex; align-items:center; justify-content:center; padding:40px;
    opacity:0; pointer-events:none; transition:opacity .3s ease;
  }
  .lightbox.open{opacity:1; pointer-events:auto;}
  .lightbox img{max-width:min(560px,90vw); max-height:86vh; border-radius:14px; box-shadow:0 30px 80px rgba(0,0,0,.5);}
  .lightbox-close{
    position:absolute; top:26px; left:26px; width:44px; height:44px; border-radius:50%;
    background:rgba(255,255,255,.1); color:#fff; border:none; font-size:1.4rem; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
  }
  .lightbox-close:hover{background:var(--orange);}

  /* ---------- PROCESS (real ordered ladder) with progress line ---------- */
  .process-wrap{position:relative; max-width:760px;}
  .process-line{
    position:absolute; top:0; bottom:0; right:27px; width:2px; background:var(--line);
  }
  .process-line-fill{
    position:absolute; top:0; right:27px; width:2px; background:var(--orange);
    height:0%; transition:height .2s ease-out;
  }
  .process{display:flex; flex-direction:column; gap:0;}
  .step{
    display:grid; grid-template-columns:64px 1fr; gap:24px;
    padding:26px 0;
    position:relative;
  }
  .step-num{
    font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1.3rem;
    width:56px; height:56px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    background:var(--ink); color:var(--orange);
    transition:background .3s ease, color .3s ease, transform .3s ease;
    position:relative; z-index:2;
  }
  .step.active .step-num{background:var(--orange); color:#fff; transform:scale(1.08);}
  .step h4{font-family:'Almarai',sans-serif; font-weight:700; font-size:1.12rem; margin-bottom:6px;}
  .step p{color:var(--muted); font-size:.95rem;}

  /* ---------- WHY US ---------- */
  .why-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
  .why-card{
    text-align:center; padding:34px 20px; background:var(--ink); border-radius:18px; color:#fff;
    position:relative; overflow:hidden; transition:transform .3s ease;
  }
  .why-card:hover{transform:translateY(-6px);}
  .why-card::before{
    content:''; position:absolute; inset:0; background:radial-gradient(circle at 30% 0%, rgba(234,91,20,.25), transparent 60%);
  }
  .why-card svg{width:34px; height:34px; color:var(--orange-2); margin-bottom:16px; position:relative;}
  .why-card h4{font-family:'Almarai',sans-serif; font-weight:700; font-size:1rem; position:relative;}

  /* platforms trust row */
  .platforms{display:flex; justify-content:center; align-items:center; gap:52px; flex-wrap:wrap; margin-top:56px; opacity:.75;}
  .platforms span{font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:1.02rem; color:var(--muted); display:flex; align-items:center; gap:8px;}

  /* ---------- RESULTS / real campaign proof ---------- */
  .results{
    display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;
  }
  .proof-card{
    background:var(--ink); border-radius:22px; padding:34px; color:#fff;
    box-shadow:0 30px 60px -24px rgba(20,19,17,.4);
  }
  .proof-top{display:flex; align-items:center; gap:10px; margin-bottom:22px; font-size:.85rem; color:#B9B4AC;}
  .proof-top .live{width:8px; height:8px; border-radius:50%; background:#59D98C; box-shadow:0 0 0 4px rgba(89,217,140,.2); animation:pulse2 1.8s ease infinite;}
  @keyframes pulse2{0%,100%{box-shadow:0 0 0 4px rgba(89,217,140,.2);} 50%{box-shadow:0 0 0 8px rgba(89,217,140,.08);}}
  .proof-title{font-weight:600; color:#fff; margin-bottom:26px; font-size:1.02rem;}
  .proof-row{display:grid; grid-template-columns:repeat(3,1fr); gap:18px; border-top:1px solid rgba(255,255,255,.12); padding-top:24px;}
  .proof-row div b{font-family:'Space Grotesk',sans-serif; font-size:1.5rem; display:block; color:var(--orange-2);}
  .proof-row div span{font-size:.78rem; color:#B9B4AC;}
  .results-copy .sec-eyebrow{margin-bottom:14px;}
  .results-copy h3{font-family:'Almarai',sans-serif; font-weight:800; font-size:1.9rem; line-height:1.35; margin-bottom:18px;}
  .results-copy p{color:var(--muted); margin-bottom:26px;}
  .results-list{display:flex; flex-direction:column; gap:14px;}
  .results-list li{display:flex; align-items:center; gap:12px; font-weight:600; font-size:.98rem; list-style:none;}
  .results-list svg{width:20px; height:20px; color:var(--orange); flex-shrink:0;}

  /* ---------- CTA / CONTACT ---------- */
  .cta{
    background:var(--ink); color:#fff; border-radius:28px; padding:70px 50px;
    position:relative; overflow:hidden; text-align:center;
  }
  .cta::before{
    content:''; position:absolute; width:600px; height:600px; border-radius:50%;
    background:radial-gradient(circle, rgba(234,91,20,.35), transparent 70%);
    top:-260px; left:50%; transform:translateX(-50%);
    animation:blob 8s ease-in-out infinite;
  }
  @keyframes blob{0%,100%{transform:translateX(-50%) scale(1);} 50%{transform:translateX(-50%) scale(1.15);}}
  .cta-inner{position:relative;}
  .cta h2{font-family:'Almarai',sans-serif; font-weight:800; font-size:clamp(1.8rem,3.4vw,2.7rem); margin-bottom:16px;}
  .cta p{color:#C9C4BC; max-width:520px; margin:0 auto 34px; font-size:1.05rem;}
  .cta-actions{display:flex; justify-content:center; gap:16px; flex-wrap:wrap; margin-bottom:36px;}
  .cta-contacts{display:flex; justify-content:center; gap:36px; flex-wrap:wrap; color:#C9C4BC; font-size:.95rem;}
  .cta-contacts a{display:flex; align-items:center; gap:8px; font-weight:600; color:#fff;}
  .cta-contacts svg{width:18px; height:18px; color:var(--orange-2);}

  /* ---------- FOOTER ---------- */
  footer{padding:44px 0 34px; border-top:1px solid var(--line);}
  .foot-row{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;}
  .foot-brand{display:flex; align-items:center; gap:10px; font-weight:700; font-family:'Almarai',sans-serif;}
  .foot-brand img{height:30px;}
  .foot-links{display:flex; gap:26px; font-size:.9rem; color:var(--muted); font-weight:600;}
  .foot-copy{color:var(--muted); font-size:.82rem; margin-top:22px; text-align:center;}

  /* reveal on scroll */
  .reveal{opacity:0; transform:translateY(24px); transition:opacity .7s ease, transform .7s ease;}
  .reveal.in{opacity:1; transform:translateY(0);}
  .stagger.in > *{transition-delay:calc(var(--i,0) * 80ms);}

  /* magnetic button wrapper */
  .magnetic{will-change:transform;}

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:980px){
    .hero-grid{grid-template-columns:1fr;}
    .services-grid{grid-template-columns:repeat(2,1fr);}
    .work-grid{grid-template-columns:repeat(2,1fr);}
    .why-grid{grid-template-columns:repeat(2,1fr);}
    .results{grid-template-columns:1fr;}
    .nav-links{display:none;}
    .burger{display:flex;}
  }
  @media (max-width:640px){
    .wrap{padding:0 20px;}
    .services-grid{grid-template-columns:1fr;}
    .work-grid{grid-template-columns:1fr;}
    .why-grid{grid-template-columns:1fr;}
    .step{grid-template-columns:48px 1fr; gap:16px;}
    .step-num{width:44px; height:44px; font-size:1.05rem;}
    .process-line, .process-line-fill{right:21px;}
    .cta{padding:50px 24px;}
    .proof-row{grid-template-columns:1fr; gap:14px;}
    .nav-cta span{display:none;}
    .hero{padding:60px 0 0;}
    .platforms{gap:28px;}
  }
</style>
</head>
<body>

<header>
  <nav class="wrap">
    <div class="brand">
      <img src="data:image/png;base64," alt="زوكادينو ماركتينج">
      <div class="brand-name">ZUKADINO<span>.</span></div>
    </div>
    <div class="nav-links">
      <a href="#services">خدماتنا</a>
      <a href="#work">أعمالنا</a>
      <a href="#process">آلية العمل</a>
      <a href="#results">النتائج</a>
      <a href="#contact">تواصل معنا</a>
    </div>
    <div class="nav-right">
      <a class="nav-cta magnetic" href="https://wa.me/201106633420" target="_blank" rel="noopener">
        <span>واتساب فوري</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 8l-5 5-5-5" transform="rotate(90 12 12)"/></svg>
      </a>
      <button class="burger" id="burgerBtn" aria-label="افتح القائمة"><span></span><span></span><span></span></button>
    </div>
  </nav>
</header>

<div class="mobile-menu" id="mobileMenu">
  <button class="close-btn" id="closeMenu">✕</button>
  <a href="#services">خدماتنا</a>
  <a href="#work">أعمالنا</a>
  <a href="#process">آلية العمل</a>
  <a href="#results">النتائج</a>
  <a href="#contact">تواصل معنا</a>
  <a class="m-cta" href="https://wa.me/201106633420" target="_blank" rel="noopener">واتساب فوري</a>
</div>

<main>
  <!-- HERO -->
